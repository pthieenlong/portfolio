---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { Header } from '@/components/layout/Header';
import { Footer } from '@/components/layout/Footer';
import { Hero } from '@/components/sections/Hero';
import { BentoGrid } from '@/components/sections/Bento';
import { Projects } from '@/components/sections/Projects';
import { Experience } from '@/components/sections/Experience';
import { Contact } from '@/components/sections/Contact';

const projectEntries = await getCollection('projects');
const projects = projectEntries
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    description: entry.data.description,
    thumbnail: entry.data.thumbnail,
    tags: entry.data.tags,
    liveUrl: entry.data.liveUrl,
    repoUrl: entry.data.repoUrl,
    featured: entry.data.featured,
  }));

const [experienceEntry] = await getCollection('experience');
const experiences = experienceEntry?.data.experiences ?? [];
---

<Layout
  title="Pham Thien Long — Frontend Developer"
  description="Hi, I'm Long, a Frontend Developer in Ho Chi Minh City building web apps with React, Next.js and NestJS."
>
  <Header client:load />

  <main>
    <Hero client:load />
    <BentoGrid client:visible />
    <Projects client:visible projects={projects} />
    <Experience client:visible experiences={experiences} />
    <Contact client:visible />
  </main>

  <Footer client:load />
</Layout>
